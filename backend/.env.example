PORT=5000
MONGODB_URI=mongodb://localhost:27017/quickstore
JWT_SECRET=your_jwt_secret
JWT_REFRESH_SECRET=your_refresh_token_secret
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
EMAIL_SERVICE=gmail
EMAIL_USER=your_email
EMAIL_PASSWORD=your_password
FRONTEND_URL=http://localhost:3000

# Subscription auto-renewal sweep (see queues/billingQueue.ts)
SUBSCRIPTION_RENEWAL_CRON=0 * * * *
SUBSCRIPTION_GRACE_PERIOD_DAYS=3

# Merchant onboarding/activation drip sweep (see queues/marketingQueue.ts)
MARKETING_DRIP_CRON=0 */6 * * *
# Base URL this API is reachable at — used to build the unsubscribe link in
# drip emails (services/emailService.ts's buildMarketingUnsubscribeLink).
BACKEND_URL=http://localhost:5000
