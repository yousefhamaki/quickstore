{
  "expo": {
    "name": "Buildora",
    "slug": "buildora-mobile-merchant",
    "scheme": "buildora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.buildora.merchant"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.buildora.merchant",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "experiments": {
      "baseUrl": "/mobile-app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Buildora to access your photos to add product images.",
          "cameraPermission": "Allow Buildora to use the camera to take product photos."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 140,
          "resizeMode": "contain",
          "backgroundColor": "#1E1B4B"
        }
      ]
    ],
    "extra": {
      "apiUrl": "http://localhost:5000/api",
      "router": {},
      "eas": {
        "projectId": "91118569-c7b9-4951-b46b-8c3650c4bed5"
      }
    },
    "owner": "yousefhamaki",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/91118569-c7b9-4951-b46b-8c3650c4bed5"
    }
  }
}
